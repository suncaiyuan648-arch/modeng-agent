# Copy to .env for local development. Never commit .env or paste real values here.
# Frontend variables prefixed with VITE_ are public and must never contain secrets.

NODE_ENV=development
PORT=3000

# Local persistence. Use a unique password outside disposable local environments.
DATABASE_URL=
POSTGRES_DB=modern_agent
POSTGRES_USER=modern_agent
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Local cache/queue.
REDIS_URL=
REDIS_PASSWORD=
REDIS_PORT=6379

# Session and application secrets. Generate with: pnpm security:generate-secret
JWT_SECRET=
SESSION_SECRET=

# Provider credentials. Keep these backend-only; do not prefix them with VITE_.
OPENAI_API_KEY=
KIMI_API_KEY=
DOUBAO_API_KEY=
DOUBAO_API_SECRET=
DEEPSEEK_API_KEY=
MODENG_TALK_DEFAULT_RELEASE=mdlrel_01jv5q2x7e8m9n4k6p3r1t0s

# Object storage credentials. Use the least-privileged account possible.
OSS_ENDPOINT=
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
