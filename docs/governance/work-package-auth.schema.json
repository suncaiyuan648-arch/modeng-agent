{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-platform.local/schemas/work-package-auth.schema.json",
  "title": "Work Package Authorization V2",
  "description": "Machine-readable authorization for exactly one Work Package or governance phase.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "kind",
    "status",
    "targetModules",
    "scope",
    "capabilities",
    "requiredCCR",
    "requiredADR",
    "requiredGovernancePrerequisites",
    "forbiddenCapabilities"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "pattern": "(^|/)work-package-auth\\.schema\\.json$"
    },
    "schemaVersion": {
      "const": "2"
    },
    "id": {
      "type": "string",
      "pattern": "^(?:WP|GOV)-[0-9]{3,}$"
    },
    "kind": {
      "type": "string",
      "enum": ["WORK_PACKAGE", "GOVERNANCE"]
    },
    "status": {
      "type": "string",
      "enum": ["APPROVED", "IMPLEMENTATION_BLOCKED", "COMPLETED", "FROZEN"]
    },
    "targetModules": {
      "$ref": "#/$defs/moduleNames"
    },
    "scope": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["module", "zones"],
        "properties": {
          "module": {
            "$ref": "#/$defs/moduleName"
          },
          "zones": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["implementation", "controlled", "frozen"]
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/yellowCapability"
      }
    },
    "requiredCCR": {
      "$ref": "#/$defs/identifiers"
    },
    "requiredADR": {
      "$ref": "#/$defs/adrIdentifiers"
    },
    "requiredGovernancePrerequisites": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repositoryPath"
      }
    },
    "forbiddenCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capability"
      }
    }
  },
  "$defs": {
    "moduleName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "moduleNames": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/moduleName"
      }
    },
    "capability": {
      "type": "string",
      "enum": [
        "compile-config",
        "dependency-sync",
        "public-facade",
        "package-export",
        "manifest-metadata",
        "asset-export",
        "shared-fixture",
        "feature-config",
        "owner-change",
        "dependency-direction-change",
        "contract-change",
        "state-machine-change",
        "migration",
        "governance-change"
      ]
    },
    "yellowCapability": {
      "type": "string",
      "enum": [
        "compile-config",
        "dependency-sync",
        "public-facade",
        "package-export",
        "manifest-metadata",
        "asset-export",
        "shared-fixture",
        "feature-config"
      ]
    },
    "identifiers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CCR-[0-9]{4,}$"
      }
    },
    "adrIdentifiers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ADR-[0-9]{4,}$"
      }
    },
    "repositoryPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
    }
  }
}
